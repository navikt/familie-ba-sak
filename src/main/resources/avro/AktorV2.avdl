@namespace("no.nav.person.pdl.aktor.v2")
protocol AktorProtoV2 {

  /**
   * UKJENT finnes ikke i PDL sitt skjema og skal aldri brukes mot PDL sine REST-/GraphQL-felter.
   * Den er reader-default slik at nye identtyper fra PDL deserialiseres til UKJENT i stedet
   * for å knekke konsumenten.
   */
  enum Type {
    FOLKEREGISTERIDENT,
    AKTORID,
    NPID,
    UKJENT
  } = UKJENT;

  record Identifikator {
    string idnummer;
    Type type;
    boolean gjeldende;
  }

  record Aktor {
    array<Identifikator> identifikatorer;
  }
}